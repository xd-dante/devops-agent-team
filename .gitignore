# Local agent config — contains org-specific hostnames, accounts, repo names
.devops-agents.yml

# Editor / OS noise
.DS_Store
*.swp
.idea/
.vscode/

# Local worktrees and scratch
.worktree/
scratch/
*.local.md

# Never commit credentials or state
*.pem
*.key
*.tfstate
*.tfstate.*
.terraform/
.env
.env.*
kubeconfig

# Local agent memory — site-specific by design, never committed here
.devops-agents/
memory/MEMORY.md
memory/instructions.md
memory/entries/*.md
!memory/entries/*.example
